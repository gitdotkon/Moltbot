# 保存到 MongoDB（带链接）
save_to_mongo() {
    local platform=$1
    local timestamp=$2
    shift 2
    local items=("$@")
    
    # 构建带链接的JSON数组
    local json_items="["
    local first=true
    for item in "${items[@]}"; do
        local title="${item%%|*}"
        local link="${item##*|}"
        if [ "$first" = true ]; then
            first=false
        else
            json_items+=","
        fi
        json_items+="{\"title\":\"$title\",\"link\":\"$link\"}"
    done
    json_items+="]"
    
    docker exec mongodb mongosh -u admin -p password --authenticationDatabase admin "$MONGO_DB" --quiet --eval "
        db.trending.insertOne({
            platform: '$platform',
            timestamp: new Date('$timestamp'),
            items: $json_items,
            createdAt: new Date()
        });
    " 2>/dev/null || warn "保存失败: $platform"
}

# 主抓取函数
do_fetch() {
    local platform=${1:-all}
    local timestamp=$(date -Iseconds)
    
    check_mongo
    init_mongo
    
    log "📊 开始抓取热门榜单: $platform"
    echo "================================"
    
    local total_count=0
    
    # 百度
    if [ "$platform" = "all" ] || [ "$platform" = "baidu" ]; then
        log "🔥 抓取百度热搜..."
        save_to_mongo "baidu" "$timestamp" "${mock_baidu[@]}"
        log "✅ 百度热搜: ${#mock_baidu[@]} 条"
        ((total_count+=${#mock_baidu[@]}))
    fi
    
    # 微博
    if [ "$platform" = "all" ] || [ "$platform" = "weibo" ]; then
        log "🔥 抓取微博热搜..."
        save_to_mongo "weibo" "$timestamp" "${mock_weibo[@]}"
        log "✅ 微博热搜: ${#mock_weibo[@]} 条"
        ((total_count+=${#mock_weibo[@]}))
    fi
    
    # 哔哩哔哩
    if [ "$platform" = "all" ] || [ "$platform" = "bilibili" ]; then
        log "🔥 抓取B站热门..."
        save_to_mongo "bilibili" "$timestamp" "${mock_bilibili[@]}"
        log "✅ B站热门: ${#mock_bilibili[@]} 条"
        ((total_count+=${#mock_bilibili[@]}))
    fi
    
    # 抖音
    if [ "$platform" = "all" ] || [ "$platform" = "douyin" ]; then
        log "🔥 抓取抖音热门..."
        save_to_mongo "douyin" "$timestamp" "${mock_douyin[@]}"
        log "✅ 抖音热门: ${#mock_douyin[@]} 条"
        ((total_count+=${#mock_douyin[@]}))
    fi
    
    echo "================================"
    log "📊 共抓取: $total_count 条热门"
    log "💾 已保存到 MongoDB"
}

# 显示数据
do_show() {
    check_mongo
    echo "=== MongoDB 数据统计 ==="
    docker exec mongodb mongosh -u admin -p password --authenticationDatabase admin "$MONGO_DB" --quiet --eval "
        ['baidu','weibo','bilibili','douyin'].forEach(p => {
            var c = db.trending.countDocuments({platform: p});
            print('[' + p.toUpperCase() + '] ' + c + ' 条记录');
        });
    "
}

# 生成 HTML
do_html() {
    check_mongo
    python3 "$(dirname "$0")/gen_html.py"
}

# 定时任务（每小时更新）
do_schedule() {
    log "📅 设置定时任务（每 $INTERVAL 分钟更新一次）..."
    local cron_script="$TRENDING_DIR/update.sh"
    cat > "$cron_script" << EOF
#!/bin/bash
cd "$(dirname "$0")"
./trending fetch all >> log.txt 2>&1
./trending html >> log.txt 2>&1
EOF
    chmod +x "$cron_script"
    
    # 每 INTERVAL 分钟执行一次
    local cron_expr="*/$INTERVAL * * * * $cron_script"
    (crontab -l 2>/dev/null | grep -v trending; echo "$cron_expr") | crontab -
    
    log "✅ 定时任务已设置（每 $INTERVAL 分钟更新）"
    log "💡 查看 crontab: crontab -l"
}

show_help() {
    cat << EOF
Social Trending - 社交媒体热门抓取工具

用法: trending <命令> [平台]

命令:
  fetch [platform]   抓取热门（保存到MongoDB）
  show               显示数据统计
  html               生成展示页面
  schedule           设置定时任务（每小时更新）

平台: baidu, weibo, bilibili, douyin

示例:
  trending fetch              # 抓取所有平台
  trending fetch baidu        # 只抓取百度
  trending show               # 显示统计
  trending html               # 生成页面
  trending schedule           # 设置每小时自动更新

EOF
}

case "$1" in
    fetch) do_fetch "$2" ;;
    show) do_show ;;
    html) do_html ;;
    schedule) do_schedule ;;
    *) show_help ;;
esac
